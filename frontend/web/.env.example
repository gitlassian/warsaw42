# Public Mapbox token (pk.*). Restrict it to the deployed web origins in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=
# Supabase project URL and the public publishable (or legacy anon) key; VITE_SUPABASE_ANON_KEY also works (Dashboard > Project Settings > API Keys).
# Row Level Security limits them to reading active AEDs and app_data; never put a secret or service_role key here.
# Leave both empty to keep running on the mock AED snapshot in public/mock.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
