# Public Mapbox token (pk.*). Restrict it to the deployed web origins in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=

# Supabase project URL and publishable key (sb_publishable_*). Safe in the browser: Row Level Security
# limits them to reading active AEDs and app_data. Never put a secret or service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
